rules_version = '2';

// Правила Firestore для Miroz (режим разработки).
// Вставьте это в Firebase Console → Firestore Database → Rules → Publish.
//
// Доступ: любой залогиненный пользователь может читать и писать
// (проекты общие для всех вошедших — удобно для работы с друзьями).
//
// Структура:
//   projects/{projectId}
//   projects/{projectId}/nodes/{nodeId}

service cloud.firestore {
  match /databases/{database}/documents {

    match /projects/{projectId} {
      allow read, write: if request.auth != null;

      match /nodes/{nodeId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
